# Copy to .env and fill in. Never commit the real .env.

# Backend base URL (default is fine for local dev)
TASKTRAIL_API_URL=http://localhost:8000

# Firebase project's Web API key (Project settings > General > Your apps)
FIREBASE_WEB_API_KEY=

# Obtained via: uv run python scripts/get_refresh_token.py
FIREBASE_REFRESH_TOKEN=

# Escape hatch for quick testing instead of the two vars above — a raw
# Firebase ID token, expires in ~1 hour. Leave unset for normal use.
# TASKTRAIL_ID_TOKEN=
